{
  "name": "redija-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "RedijaApp - Editor acadêmico visual moderno, intuitivo e automatizado com foco em ABNT e Typst",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"*.{json,js,ts,md}\""
  },
  "dependencies": {
    "@myriaddreamin/typst-ts-renderer": "^0.7.0",
    "@myriaddreamin/typst-ts-web-compiler": "^0.7.0",
    "@myriaddreamin/typst.ts": "^0.7.0",
    "@tiptap/extension-placeholder": "^3.33.0",
    "@tiptap/extension-subscript": "^3.33.0",
    "@tiptap/extension-superscript": "^3.33.0",
    "@tiptap/extension-underline": "^3.33.0",
    "@tiptap/pm": "^3.33.0",
    "@tiptap/react": "^3.33.0",
    "@tiptap/starter-kit": "^3.33.0",
    "clsx": "^2.1.1",
    "dexie": "^4.4.7",
    "jszip": "^3.10.2",
    "lucide-react": "^1.16.0",
    "mammoth": "^1.13.0",
    "peerjs": "^1.5.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@myriaddreamin/typst-ts-node-compiler": "^0.7.0",
    "@playwright/test": "^1.65.0",
    "@types/jszip": "^3.4.0",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fake-indexeddb": "^6.2.7",
    "globals": "^17.14.0",
    "postcss": "^8.4.49",
    "prettier": "^3.9.10",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^6.0.7",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "minimatch": "^11.0.5"
  }
}
