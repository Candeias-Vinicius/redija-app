# RedijaApp — Variáveis de Ambiente
# Obtenha o Client ID no Google Cloud Console (opcional para Modo Convidado/Demo):
# 1. Acesse https://console.cloud.google.com/apis/credentials
# 2. Crie uma credencial do tipo "ID do cliente OAuth 2.0" -> "Aplicativo da Web"
# 3. Adicione "http://localhost:3000" nas "Origens JavaScript autorizadas"
# 4. Copie o Client ID gerado e cole abaixo:
VITE_GOOGLE_CLIENT_ID=seu_client_id_aqui.apps.googleusercontent.com

# Obrigatório em produção para abrir arquivos compartilhados via Google Picker API:
# 1. Ative a API "Google Picker API" no Google Cloud Console
# 2. Crie uma "Chave de API" restringida por referenciador HTTP ao seu domínio
# VITE_GOOGLE_API_KEY=sua_api_key_aqui
# Opcional — Número do projeto no Google Cloud (inferido automaticamente do Client ID se omitido):
# VITE_GOOGLE_APP_ID=123456789012

# Opcional — Servidor TURN customizado para P2P WebRTC em redes acadêmicas/corporativas restritas:
# VITE_TURN_URL=turn:seu-servidor-turn.exemplo.com:3478
# VITE_TURN_USERNAME=usuario
# VITE_TURN_CREDENTIAL=senha
# VITE_ICE_SERVERS_JSON=[{"urls":"turns:turn.exemplo.com:5349","username":"...","credential":"..."}]

# Opcional — Apenas para o endpoint serverless /api/feedback em produção (Vercel):
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx
# RESEND_FROM_EMAIL=RedijaApp <onboarding@resend.dev>
# RESEND_TO_EMAIL=contato.redija@gmail.com
